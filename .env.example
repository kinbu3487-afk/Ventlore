# ==============================================================================
# Ventlore Platform — Mẫu Cấu Hình Biến Môi Trường Cục Bộ (.env.example)
# Lưu ý: Tuyệt đối không lưu trữ khóa bí mật, private keys thật trong file này.
# Sao chép file này thành .env.local trong từng worktree và điều chỉnh theo port tương ứng.
# ==============================================================================

# Node Environment
NODE_ENV=development

# Web Server Port (FE: 3001, BE: 3002, MERGE: 3000)
PORT=3000

# Mock Mode (FE bật true để chạy MockAdapter; BE/MERGE tắt false để dùng API & DB thật)
NEXT_PUBLIC_USE_MOCK_API=true

# Database (PostgreSQL dành cho BE hoặc Integration)
# BE dùng port 5433 (ventlore_be); MERGE dùng port 5432 (ventlore_integration)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/ventlore_integration

# Local Blockchain (Anvil Local Node)
# CHAIN dùng port 8546; MERGE dùng port 8545
NEXT_PUBLIC_CHAIN_ID=31337
NEXT_PUBLIC_RPC_URL=http://127.0.0.1:8545

# Authentication & Session (Placeholder cho môi trường local)
SESSION_SECRET=placeholder_local_session_secret_min_32_chars_long
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Third-party Services (Đánh dấu NOT_CONFIGURED trong môi trường local)
# GOOGLE_CLIENT_ID=NOT_CONFIGURED
# GOOGLE_CLIENT_SECRET=NOT_CONFIGURED
# STRIPE_SECRET_KEY=NOT_CONFIGURED
