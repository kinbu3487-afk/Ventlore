{
  "name": "ventlore-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "Ventlore platform monorepo",
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20.18.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm --filter @ventlore/web dev",
    "worker": "pnpm --filter @ventlore/worker dev",
    "test": "pnpm -r run test",
    "lint": "pnpm -r run lint",
    "typecheck": "pnpm -r run typecheck",
    "validate:foundation": "python3 scripts/validate_foundation.py",
    "verify": "python3 scripts/validate_foundation.py && pnpm -r run typecheck && pnpm -r run lint && pnpm -r run build",
    "build:export": "STATIC_EXPORT=true pnpm --filter @ventlore/web build",
    "package:netlify": "bash scripts/package_netlify.sh"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
